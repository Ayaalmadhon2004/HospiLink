DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace_with_a_long_random_string
PORT=5000

# Optional: extra comma separated CORS origins merged with the built-in defaults
CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Optional: pino log level (default: info in production, debug otherwise)
LOG_LEVEL=info
SENTRY_DSN=
# Optional: enables POST /api/internal/run-reminders (header x-reminders-secret); the endpoint is 404 when unset
REMINDERS_CRON_SECRET=replace_with_a_long_random_string
