DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace_with_a_long_random_string
PORT=5000

# Optional: extra comma separated CORS origins merged with the built-in defaults
CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Optional: pino log level (default: info in production, debug otherwise)
LOG_LEVEL=info
SENTRY_DSN=
# Optional: enables POST /api/internal/run-reminders (header x-reminders-secret); the endpoint is 404 when unset
REMINDERS_CRON_SECRET=replace_with_a_long_random_string
# Optional: shared parent domain of the app and the API (e.g. .example.com). Switches the auth cookie to SameSite=Lax
COOKIE_DOMAIN=
# Public URL of the frontend (links in emails point here) and the SMTP transport for password reset / email verification
APP_URL=https://app.example.com
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
MAIL_FROM="HospiLink <no-reply@example.com>"
