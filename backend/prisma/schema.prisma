generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hospital {
  id        String    @id @default(uuid())
  name      String
  location  String
  // Public signup code (uppercase). An admin shares it with staff who should join this hospital.
  code      String    @unique
  // IANA time zone used for "today" ranges, hour grouping and times in notifications.
  timezone  String    @default("UTC")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  beds      Bed[]
  patients  Patient[]
  users     User[]
  wards     Ward[]
  staff     Staff[]
  incidents Incident[]
  dispatchUnits DispatchUnit[]
  dispatchCalls DispatchCall[]
  vitalThresholds VitalThresholds[]
}

model User {
  id         String        @id @default(uuid())
  email      String        @unique
  password   String
  name       String
  role       Role          @default(DOCTOR)
  department String
  shift      ShiftType
  status     DutyStatus    @default(OFF_DUTY)
  // Login/approval state. Public signup creates PENDING; only an ADMIN activates (see users.controller).
  accountStatus AccountStatus @default(ACTIVE)
  hospitalId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  patients   Patient[]
  hospital   Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  settings   UserSettings?
  notifications Notification[]
  emailVerifiedAt   DateTime?
  // Tokens issued before this instant are rejected (password change/reset revokes sessions).
  passwordChangedAt DateTime?
  authTokens        AuthToken[]
  // TOTP 2FA. The secret is AES-256-GCM encrypted (config/twoFactor.ts); it is only active once twoFactorEnabledAt is set.
  twoFactorSecretEnc   String?
  twoFactorEnabledAt   DateTime?
  twoFactorLastStep    Int?
  twoFactorFailures    Int       @default(0)
  twoFactorLockedUntil DateTime?
  recoveryCodes        TwoFactorRecoveryCode[]
  // Staff record (doctor, nurse...) of this login, if any. The link is explicit, never matched by email at runtime.
  staff                Staff?
}

model TwoFactorRecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  codeHash String
  usedAt   DateTime?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// Single-use emailed tokens. Only the sha256 of the token is stored.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  criticalVitalsAlerts Boolean  @default(true)
  incidentEscalations  Boolean  @default(true)
  shiftReminders       Boolean  @default(false)
  dispatchAlerts       Boolean  @default(true)
  appointmentReminders Boolean  @default(true)
  twoFactorAuth        Boolean  @default(false)
  autoLockIdleSessions Boolean  @default(true)
  compactDensity       Boolean  @default(false)
  theme                String   @default("light")
  language             String   @default("en")
  timezone             String   @default("UTC")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
}

model Patient {
  id            String          @id @default(uuid())
  name          String
  age           Int
  status        PatientStatus   @default(OBSERVATION)
  admissionDate DateTime        @default(now())
  bedId         String?         @unique
  hospitalId    String
  createdAt     DateTime        @default(now())
  department    String
  diagnosis     String
  dischargeDate DateTime?
  doctorId      String?
  gender        Gender
  patientCode   String          @unique
  updatedAt     DateTime        @updatedAt
  appointments  Appointment[]
  bed           Bed?            @relation("BedPatient", fields: [bedId], references: [id])
  doctor        User?           @relation(fields: [doctorId], references: [id])
  hospital      Hospital        @relation(fields: [hospitalId], references: [id])
  vitals        PatientVitals[]
  reports       Report[]

  @@index([hospitalId])
}

model Report {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileData   Bytes?
  patientId  String
  uploadedBy String?
  createdAt  DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Ward {
  id         String   @id @default(uuid())
  name       String
  floor      Int?
  hospitalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  beds       Bed[]
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}

model Bed {
  id         String    @id @default(uuid())
  bedNumber  String
  status     BedStatus @default(AVAILABLE)
  hospitalId String
  wardId     String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  ward       Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  patient    Patient?  @relation("BedPatient")

  @@unique([bedNumber, wardId])
  @@index([hospitalId])
}

model PatientVitals {
  id              String   @id @default(uuid())
  patientId       String
  heartRate       Int?
  systolicBP      Int?
  diastolicBP     Int?
  spO2            Float?
  temperature     Float?
  respiratoryRate Int?
  recordedAt      DateTime @default(now())
  recordedBy      String
  notes           String?
  isCritical      Boolean  @default(false)
  alertType       String?
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([recordedAt])
  @@index([isCritical])
}

// Per hospital and department. A (department, vitalType) without a row falls back to the built-in defaults
// in services/vitalThresholds.ts, so a missing row never means "no alerts".
model VitalThresholds {
  id           String  @id @default(uuid())
  hospitalId   String
  department   String
  vitalType    String
  minNormal    Float?
  maxNormal    Float?
  minCritical  Float?
  maxCritical  Float?
  alertEnabled Boolean @default(true)
  autoNotify   Boolean @default(false)
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, department, vitalType])
  @@index([hospitalId])
}

model Staff {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  role         String
  department   String
  avatar       String?
  phone        String?
  isActive     Boolean       @default(true)
  hospitalId   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  // Login (User) of this staff member. Appointment/shift notifications go to it; null = no login, nobody is notified.
  userId       String?       @unique
  appointments Appointment[]
  shifts       Shift[]
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
}

model Shift {
  id         String   @id @default(uuid())
  staffId    String
  type       ShiftType
  startTime  DateTime
  endTime    DateTime
  department String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  staff      Staff    @relation(fields: [staffId], references: [id])
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  doctorId    String
  scheduledAt DateTime
  type        AppointmentType
  status      AppointmentStatus @default(SCHEDULED)
  department  String
  room        String?
  notes       String?
  duration    Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  doctor      Staff    @relation(fields: [doctorId], references: [id])
  patient     Patient  @relation(fields: [patientId], references: [id])

  @@index([scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@index([status])
}

model Incident {
  id          String    @id @default(uuid())
  code        String
  title       String
  description String?
  type        IncidentType
  severity    IncidentSeverity
  status      IncidentStatus @default(ACTIVE)
  location    String
  teams       Int       @default(1)
  progress    Int       @default(0)
  triageLevel String?
  reportedBy  String
  resolvedAt  DateTime?
  hospitalId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model DispatchUnit {
  id            String        @id @default(uuid())
  unitCode      String
  unitType      UnitType
  status        UnitStatus    @default(AVAILABLE)
  location      String?
  eta           Int?
  department    String        @default("ER")
  crew          String[]
  currentCallId String?       @unique
  hospitalId    String
  lastUpdated   DateTime      @updatedAt
  createdAt     DateTime      @default(now())
  currentCall   DispatchCall? @relation("UnitCall", fields: [currentCallId], references: [id])
  hospital      Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, unitCode])
  @@index([hospitalId])
}

model DispatchCall {
  id             String        @id @default(uuid())
  type           String
  location       String
  priority       Priority      @default(MEDIUM)
  status         CallStatus    @default(PENDING)
  notes          String?
  // History of which unit handled the call. Not unique: a unit handles many calls over time (the live link is DispatchUnit.currentCallId).
  assignedUnitId String?
  hospitalId     String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  assignedUnit   DispatchUnit? @relation("UnitCall")
  hospital       Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([assignedUnitId])
}

enum AccountStatus {
  PENDING   // self-registered, waiting for an ADMIN
  ACTIVE
  DISABLED  // rejected or deactivated by an ADMIN
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  DISPATCHER
}

enum PatientStatus {
  OBSERVATION
  CRITICAL
  STABLE
  DISCHARGED
}

enum Gender {
  MALE
  FEMALE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum UnitType {
  AMBULANCE
  PARAMEDIC
  HELICOPTER
  FIRE_TRUCK
  POLICE
}

enum UnitStatus {
  AVAILABLE
  EN_ROUTE
  ON_SCENE
  TRANSPORTING
  AT_HOSPITAL
  OFF_DUTY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CallStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  ON_SCENE
  COMPLETED
  CANCELLED
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // INCIDENT, VITALS, APPOINTMENT, SHIFT, SYSTEM
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// Closed value sets (were free-form strings). Staff.role / department stay free-form on purpose: they are job
// titles / hospital-defined names (seed has 'ER Physician', 'Anesthesiologist', ...).
enum ShiftType {
  DAY
  EVENING
  NIGHT
  ON_CALL
}

enum DutyStatus {
  ON_DUTY
  OFF_DUTY
}

enum AppointmentType {
  CONSULTATION
  SURGERY
  IMAGING
  FOLLOW_UP
  LAB_TEST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum IncidentType {
  MEDICAL_ERROR
  EQUIPMENT_FAILURE
  PATIENT_FALL
  SECURITY
  OTHER
}

enum IncidentSeverity {
  CRITICAL
  ELEVATED
  MODERATE
  LOW
}

enum IncidentStatus {
  ACTIVE
  PENDING
  RESOLVED
}


// Idempotency ledger for scheduled reminders. A reminder is claimed with an INSERT ... ON CONFLICT DO NOTHING
// on this unique key, so concurrent runs/instances can never send the same reminder twice.
model ReminderLog {
  id        String   @id @default(uuid())
  userId    String
  kind      String   // SHIFT | APPOINTMENT
  dedupeKey String   // shift id, or `<appointmentId>-<scheduledAt ms>` (a rescheduled appointment is reminded again)
  sentAt    DateTime @default(now())

  @@unique([userId, kind, dedupeKey])
  @@index([sentAt])
}
