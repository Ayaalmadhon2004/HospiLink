generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hospital {
  id        String    @id @default(uuid())
  name      String
  location  String
  // Public signup code (uppercase). An admin shares it with staff who should join this hospital.
  code      String    @unique
  // IANA time zone used for "today" ranges, hour grouping and times in notifications.
  timezone  String    @default("UTC")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  beds      Bed[]
  patients  Patient[]
  users     User[]
  wards     Ward[]
  staff     Staff[]
  incidents Incident[]
  dispatchUnits DispatchUnit[]
  dispatchCalls DispatchCall[]
  vitalThresholds VitalThresholds[]
  deviceKeys DeviceKey[]
  // Last invoice number handed out (incremented atomically when an invoice is issued, so numbers are gap-free).
  invoiceSeq Int @default(0)
  stockMovements StockMovement[]
  dispensations Dispensation[]
  invoices Invoice[]
  auditLogs AuditLog[]
  medications Medication[]
  clinicalNotes ClinicalNote[]
  prescriptions Prescription[]
  labOrders LabOrder[]
}

model User {
  id         String        @id @default(uuid())
  email      String        @unique
  password   String
  name       String
  role       Role          @default(DOCTOR)
  department String
  shift      ShiftType
  status     DutyStatus    @default(OFF_DUTY)
  // Login/approval state. Public signup creates PENDING; only an ADMIN activates (see users.controller).
  accountStatus AccountStatus @default(ACTIVE)
  hospitalId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  hospital   Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  settings   UserSettings?
  notifications Notification[]
  emailVerifiedAt   DateTime?
  // Tokens issued before this instant are rejected (password change/reset revokes sessions).
  passwordChangedAt DateTime?
  authTokens        AuthToken[]
  // TOTP 2FA. The secret is AES-256-GCM encrypted (config/twoFactor.ts); it is only active once twoFactorEnabledAt is set.
  twoFactorSecretEnc   String?
  twoFactorEnabledAt   DateTime?
  twoFactorLastStep    Int?
  twoFactorFailures    Int       @default(0)
  twoFactorLockedUntil DateTime?
  recoveryCodes        TwoFactorRecoveryCode[]
  // Staff record (doctor, nurse...) of this login, if any. The link is explicit, never matched by email at runtime.
  staff                Staff?
  auditLogs            AuditLog[]
  authoredNotes        ClinicalNote[]
  prescribed           Prescription[]
  orderedLabs          LabOrder[]
  stockMovements       StockMovement[]
  dispensed            Dispensation[]
  receivedPayments     Payment[]
}

model TwoFactorRecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  codeHash String
  usedAt   DateTime?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// Single-use emailed tokens. Only the sha256 of the token is stored.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  criticalVitalsAlerts Boolean  @default(true)
  incidentEscalations  Boolean  @default(true)
  shiftReminders       Boolean  @default(false)
  dispatchAlerts       Boolean  @default(true)
  appointmentReminders Boolean  @default(true)
  twoFactorAuth        Boolean  @default(false)
  autoLockIdleSessions Boolean  @default(true)
  compactDensity       Boolean  @default(false)
  theme                String   @default("light")
  language             String   @default("en")
  timezone             String   @default("UTC")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Session tokens revoked by logout (jti of the JWT). Rows are only needed until expiresAt and are purged on logout.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Append-only trail of mutating requests. userId is nullable + SetNull so the trail outlives a deleted login.
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  entityId  String
  details   String?
  // Tenant of the actor, copied at write time so the trail stays scoped after the user is deleted (NULL = legacy row
  // whose actor was already gone: never shown to any hospital).
  hospitalId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital  Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([hospitalId, createdAt])
  @@index([userId, createdAt])
  @@index([entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

model Patient {
  id            String          @id @default(uuid())
  name          String
  age           Int
  status        PatientStatus   @default(OBSERVATION)
  admissionDate DateTime        @default(now())
  bedId         String?         @unique
  hospitalId    String
  createdAt     DateTime        @default(now())
  department    String
  diagnosis     String
  dischargeDate DateTime?
  // Attending doctor: a Staff record (same target as Appointment.doctorId). Its login, if any, is Staff.userId.
  doctorId      String?
  // Soft delete: patient rows are never hard-deleted (a DB trigger enforces it). Every read must filter deletedAt: null.
  deletedAt     DateTime?
  gender        Gender
  patientCode   String          @unique
  updatedAt     DateTime        @updatedAt
  appointments  Appointment[]
  bed           Bed?            @relation("BedPatient", fields: [bedId], references: [id], onDelete: SetNull)
  doctor        Staff?          @relation("PatientDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  hospital      Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  vitals        PatientVitals[]
  reports       Report[]
  clinicalNotes ClinicalNote[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  dispensations Dispensation[]
  invoices      Invoice[]

  @@index([hospitalId, deletedAt])
  @@index([doctorId])
}

model Report {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileData   Bytes?
  patientId  String
  uploadedBy String?
  createdAt  DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Ward {
  id         String   @id @default(uuid())
  name       String
  floor      Int?
  hospitalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  beds       Bed[]
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}

model Bed {
  id         String    @id @default(uuid())
  bedNumber  String
  status     BedStatus @default(AVAILABLE)
  hospitalId String
  wardId     String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  ward       Ward      @relation(fields: [wardId], references: [id], onDelete: Restrict)
  patient    Patient?  @relation("BedPatient")

  @@unique([bedNumber, wardId])
  @@index([hospitalId])
  @@index([wardId])
}

model PatientVitals {
  id              String   @id @default(uuid())
  patientId       String
  heartRate       Int?
  systolicBP      Int?
  diastolicBP     Int?
  spO2            Float?
  temperature     Float?
  respiratoryRate Int?
  recordedAt      DateTime @default(now())
  recordedBy      String
  notes           String?
  isCritical      Boolean  @default(false)
  alertType       String?
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([recordedAt])
  @@index([isCritical])
}

// Per hospital and department. A (department, vitalType) without a row falls back to the built-in defaults
// in services/vitalThresholds.ts, so a missing row never means "no alerts".
model VitalThresholds {
  id           String  @id @default(uuid())
  hospitalId   String
  department   String
  vitalType    String
  minNormal    Float?
  maxNormal    Float?
  minCritical  Float?
  maxCritical  Float?
  alertEnabled Boolean @default(true)
  autoNotify   Boolean @default(false)
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, department, vitalType])
  @@index([hospitalId])
}

// Credential of a medical device / gateway / MQTT bridge that pushes readings to POST /api/vitals/ingest/:protocol.
// Only the SHA-256 of the key is stored (keys are 256-bit random, so a fast hash is enough); the key is shown once on creation.
model DeviceKey {
  id         String    @id @default(uuid())
  hospitalId String
  name       String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}

// ---- Clinical records. Hospital-scoped, never hard-deleted (Restrict) and never edited in place where noted. ----

enum NoteType {
  PROGRESS
  ADMISSION
  CONSULTATION
  DISCHARGE
  NURSING
}

// Append-only: a correction is a NEW row with supersedesId = the corrected note (DB trigger rejects UPDATE/DELETE).
// supersedesId is unique, so a note has at most one amendment and the history is a chain, never a fork.
model ClinicalNote {
  id           String        @id @default(uuid())
  hospitalId   String
  patientId    String
  type         NoteType
  content      String
  // Login of the author, plus a snapshot of the name so the note stays attributable after the account is deleted.
  authorId     String?
  authorName   String
  supersedesId String?       @unique
  createdAt    DateTime      @default(now())
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author       User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  supersedes   ClinicalNote? @relation("NoteAmendment", fields: [supersedesId], references: [id], onDelete: Restrict)
  amendment    ClinicalNote? @relation("NoteAmendment")

  @@index([patientId, createdAt])
  @@index([hospitalId])
}

// Per-hospital drug catalogue. Retired with active=false (prescriptions keep pointing at it).
model Medication {
  id          String             @id @default(uuid())
  hospitalId  String
  name        String
  genericName String?
  form        String // tablet, injection, syrup...
  strength    String // "500 mg"
  active      Boolean            @default(true)
  // Pharmacy: units on hand (a DB CHECK keeps it >= 0), alert threshold, and the price per unit in minor currency units.
  stockQuantity  Int @default(0)
  reorderLevel   Int @default(0)
  unitPriceMinor Int @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  hospital    Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  items       PrescriptionItem[]
  movements   StockMovement[]
  dispensations Dispensation[]

  @@unique([hospitalId, name, form, strength])
  @@index([hospitalId, active])
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// Items are fixed at creation; only the status moves (ACTIVE -> COMPLETED | CANCELLED). To change a dose, cancel and re-prescribe.
model Prescription {
  id             String             @id @default(uuid())
  hospitalId     String
  patientId      String
  status         PrescriptionStatus @default(ACTIVE)
  notes          String?
  prescriberId   String?
  prescriberName String
  createdAt      DateTime           @default(now())
  closedAt       DateTime?
  hospital       Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescriber     User?              @relation(fields: [prescriberId], references: [id], onDelete: SetNull)
  items          PrescriptionItem[]

  @@index([patientId, createdAt])
  @@index([hospitalId, status])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicationId   String
  dose           String
  frequency      String
  route          String?
  durationDays   Int?
  instructions   String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication     Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  dispensations  Dispensation[]

  @@index([prescriptionId])
  @@index([medicationId])
}

// ---- Pharmacy and billing. Money is always an integer in minor units (cents/fils): never a float. ----

enum StockMovementType {
  RECEIVE
  DISPENSE
  ADJUST
}

// Append-only ledger behind Medication.stockQuantity: every change to the stock writes one row in the same transaction.
model StockMovement {
  id           String            @id @default(uuid())
  hospitalId   String
  medicationId String
  type         StockMovementType
  delta        Int
  note         String?
  userId       String?
  userName     String
  createdAt    DateTime          @default(now())
  hospital     Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  medication   Medication        @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([medicationId, createdAt])
  @@index([hospitalId, createdAt])
}

// Units handed to a patient against a prescription item. The price is a snapshot; invoiceLineId is set once billed.
model Dispensation {
  id               String           @id @default(uuid())
  hospitalId       String
  patientId        String
  prescriptionItemId String
  medicationId     String
  quantity         Int
  unitPriceMinor   Int
  dispensedById    String?
  dispensedByName  String
  createdAt        DateTime         @default(now())
  invoiceLineId    String?          @unique
  hospital         Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  item             PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Restrict)
  medication       Medication       @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  dispensedBy      User?            @relation(fields: [dispensedById], references: [id], onDelete: SetNull)
  invoiceLine      InvoiceLine?     @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([prescriptionItemId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  INSURANCE
  TRANSFER
}

// DRAFT is editable and has no number; ISSUED gets the next gap-free number and is frozen; PAID when payments cover the total.
model Invoice {
  id            String        @id @default(uuid())
  hospitalId    String
  patientId     String
  number        String?
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD")
  discountMinor Int           @default(0)
  // Denormalised, recomputed by the server on every draft change; frozen at issue.
  totalMinor    Int           @default(0)
  paidMinor     Int           @default(0)
  createdAt     DateTime      @default(now())
  issuedAt      DateTime?
  voidedAt      DateTime?
  hospital      Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  lines         InvoiceLine[]
  payments      Payment[]

  @@unique([hospitalId, number])
  @@index([hospitalId, status, createdAt])
  @@index([patientId])
}

model InvoiceLine {
  id             String        @id @default(uuid())
  invoiceId      String
  description    String
  quantity       Int
  unitPriceMinor Int
  totalMinor     Int
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dispensation   Dispensation?

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(uuid())
  invoiceId      String
  hospitalId     String
  amountMinor    Int
  method         PaymentMethod
  reference      String?
  receivedById   String?
  receivedByName String
  createdAt      DateTime      @default(now())
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedBy     User?         @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

enum LabPriority {
  ROUTINE
  URGENT
  STAT
}

enum LabOrderStatus {
  ORDERED
  RESULTED
  CANCELLED
}

enum LabFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
}

model LabOrder {
  id            String         @id @default(uuid())
  hospitalId    String
  patientId     String
  testName      String
  testCode      String?
  priority      LabPriority    @default(ROUTINE)
  status        LabOrderStatus @default(ORDERED)
  notes         String?
  orderedById   String?
  orderedByName String
  orderedAt     DateTime       @default(now())
  resultedAt    DateTime?
  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  orderedBy     User?          @relation(fields: [orderedById], references: [id], onDelete: SetNull)
  results       LabResult[]

  @@index([patientId, orderedAt])
  @@index([hospitalId, status])
}

// One analyte of an order (e.g. "Hemoglobin"). Results are entered once; the flag is computed by the server from the
// numeric value and the reference/critical limits, never trusted from the client.
model LabResult {
  id           String   @id @default(uuid())
  labOrderId   String
  analyte      String
  value        Float?
  textValue    String?
  unit         String?
  refLow       Float?
  refHigh      Float?
  criticalLow  Float?
  criticalHigh Float?
  flag         LabFlag?
  labOrder     LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@index([labOrderId])
}

model Staff {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  role         String
  department   String
  avatar       String?
  phone        String?
  isActive     Boolean       @default(true)
  hospitalId   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  // Login (User) of this staff member. Appointment/shift notifications go to it; null = no login, nobody is notified.
  userId       String?       @unique
  // Crew membership: a staff member crews at most one unit at a time (null = not on a unit).
  dispatchUnitId String?
  appointments Appointment[]
  patients     Patient[]     @relation("PatientDoctor")
  shifts       Shift[]
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  dispatchUnit DispatchUnit? @relation("UnitCrew", fields: [dispatchUnitId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([dispatchUnitId])
}

model Shift {
  id         String   @id @default(uuid())
  staffId    String
  type       ShiftType
  startTime  DateTime
  endTime    DateTime
  department String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startTime])
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  doctorId    String
  scheduledAt DateTime
  type        AppointmentType
  status      AppointmentStatus @default(SCHEDULED)
  department  String
  room        String?
  notes       String?
  duration    Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  doctor      Staff    @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@index([status])
}

model Incident {
  id          String    @id @default(uuid())
  code        String
  title       String
  description String?
  type        IncidentType
  severity    IncidentSeverity
  status      IncidentStatus @default(ACTIVE)
  location    String
  teams       Int       @default(1)
  progress    Int       @default(0)
  triageLevel String?
  reportedBy  String
  resolvedAt  DateTime?
  hospitalId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model DispatchUnit {
  id            String        @id @default(uuid())
  unitCode      String
  unitType      UnitType
  status        UnitStatus    @default(AVAILABLE)
  // Last known GPS position (was a JSON string in `location`).
  lat           Float?
  lng           Float?
  eta           Int?
  department    String        @default("ER")
  currentCallId String?       @unique
  hospitalId    String
  lastUpdated   DateTime      @updatedAt
  createdAt     DateTime      @default(now())
  currentCall   DispatchCall? @relation("UnitCall", fields: [currentCallId], references: [id])
  crew          Staff[]       @relation("UnitCrew")
  hospital      Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, unitCode])
  @@index([hospitalId])
}

model DispatchCall {
  id             String        @id @default(uuid())
  type           String
  location       String
  priority       Priority      @default(MEDIUM)
  status         CallStatus    @default(PENDING)
  notes          String?
  // History of which unit handled the call. Not unique: a unit handles many calls over time (the live link is DispatchUnit.currentCallId).
  assignedUnitId String?
  hospitalId     String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  assignedUnit   DispatchUnit? @relation("UnitCall")
  hospital       Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([assignedUnitId])
}

enum AccountStatus {
  PENDING   // self-registered, waiting for an ADMIN
  ACTIVE
  DISABLED  // rejected or deactivated by an ADMIN
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  DISPATCHER
}

enum PatientStatus {
  OBSERVATION
  CRITICAL
  STABLE
  DISCHARGED
}

enum Gender {
  MALE
  FEMALE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum UnitType {
  AMBULANCE
  PARAMEDIC
  HELICOPTER
  FIRE_TRUCK
  POLICE
}

enum UnitStatus {
  AVAILABLE
  EN_ROUTE
  ON_SCENE
  TRANSPORTING
  AT_HOSPITAL
  OFF_DUTY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CallStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  ON_SCENE
  COMPLETED
  CANCELLED
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // INCIDENT, VITALS, APPOINTMENT, SHIFT, SYSTEM
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// Closed value sets (were free-form strings). Staff.role / department stay free-form on purpose: they are job
// titles / hospital-defined names (seed has 'ER Physician', 'Anesthesiologist', ...).
enum ShiftType {
  DAY
  EVENING
  NIGHT
  ON_CALL
}

enum DutyStatus {
  ON_DUTY
  OFF_DUTY
}

enum AppointmentType {
  CONSULTATION
  SURGERY
  IMAGING
  FOLLOW_UP
  LAB_TEST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum IncidentType {
  MEDICAL_ERROR
  EQUIPMENT_FAILURE
  PATIENT_FALL
  SECURITY
  OTHER
}

enum IncidentSeverity {
  CRITICAL
  ELEVATED
  MODERATE
  LOW
}

enum IncidentStatus {
  ACTIVE
  PENDING
  RESOLVED
}


// Idempotency ledger for scheduled reminders. A reminder is claimed with an INSERT ... ON CONFLICT DO NOTHING
// on this unique key, so concurrent runs/instances can never send the same reminder twice.
model ReminderLog {
  id        String   @id @default(uuid())
  userId    String
  kind      String   // SHIFT | APPOINTMENT
  dedupeKey String   // shift id, or `<appointmentId>-<scheduledAt ms>` (a rescheduled appointment is reminded again)
  sentAt    DateTime @default(now())

  @@unique([userId, kind, dedupeKey])
  @@index([sentAt])
}
