# Required. API base URL including the /api suffix (absolute URL, or a same-origin path such as /api).
VITE_API_URL=http://localhost:5000/api

# Optional: Web Vitals collector (production builds only). Unset = nothing is measured or sent.
# Point it at the backend: <API>/telemetry/web-vitals. VITE_VITALS_SAMPLE (0..1, default 1) samples page loads.
VITE_VITALS_ENDPOINT=
# VITE_VITALS_SAMPLE=0.1
