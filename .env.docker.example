# Copy to .env.docker and fill in. Placeholders only; never commit real values.
# Usage: docker compose --env-file .env.docker up --build

POSTGRES_USER=hospilink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hospilink

# Long random string (e.g. `openssl rand -hex 48`). The backend refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: error reporting
SENTRY_DSN=

# Host ports
BACKEND_PORT=5000
FRONTEND_PORT=8080

# Extra allowed CORS origins (comma separated). Must contain the frontend origin.
CORS_ORIGINS=http://localhost:8080

# API URL as seen by the BROWSER, with /api. Baked into the frontend at build time.
VITE_API_URL=http://localhost:5000/api
